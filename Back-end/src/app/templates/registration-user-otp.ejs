<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="x-apple-disable-message-reformatting">
    <title>Verify your email | Math Solution</title>
  </head>
  <body style="margin:0; padding:0; background-color:#f3f6fb; font-family:Arial, Helvetica, sans-serif; color:#172033;">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background-color:#f3f6fb;">
      <tr>
        <td align="center" style="padding:40px 16px;">
          <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="max-width:520px; background-color:#ffffff; border:1px solid #e5eaf2; border-radius:16px;">
            <tr>
              <td style="padding:32px 32px 12px;">
                <p style="margin:0 0 8px; color:#2563eb; font-size:14px; font-weight:700; letter-spacing:1px; text-transform:uppercase;">Math Solution</p>
                <h1 style="margin:0; font-size:26px; line-height:1.3; color:#172033;">Verify your email</h1>
              </td>
            </tr>
            <tr>
              <td style="padding:8px 32px 24px; font-size:16px; line-height:1.6;">
                <p style="margin:0 0 12px;">Hello <%= fullName %>,</p>
                <p style="margin:0;">Use this verification code to finish creating your account:</p>
              </td>
            </tr>
            <tr>
              <td align="center" style="padding:0 32px 8px;">
                <div style="display:inline-block; padding:16px 24px; border:1px solid #dbeafe; border-radius:12px; background-color:#eff6ff; color:#1d4ed8; font-size:32px; font-weight:700; letter-spacing:10px; line-height:1.2; user-select:all; -webkit-user-select:all;">
                  <%= otp %>
                </div>
              </td>
            </tr>
            <tr>
              <td align="center" style="padding:8px 32px 24px; color:#64748b; font-size:13px; line-height:1.5;">
                Select the code above and copy it into the verification form.
              </td>
            </tr>
            <tr>
              <td style="padding:0 32px 28px; font-size:14px; line-height:1.6; color:#475569;">
                <p style="margin:0 0 12px;">This code expires in <strong><%= expirationMinutes %> minutes</strong>.</p>
                <p style="margin:0;">If you did not request this code, you can safely ignore this email.</p>
              </td>
            </tr>
            <tr>
              <td style="padding:18px 32px; border-top:1px solid #e5eaf2; color:#94a3b8; font-size:12px; text-align:center;">
                Math Solution account security
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>