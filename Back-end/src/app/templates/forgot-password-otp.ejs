<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Password reset | Math Solution</title>
  </head>
  <body style="margin:0; padding:24px; background-color:#f3f6fb; font-family:Arial, Helvetica, sans-serif; color:#172033;">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="max-width:520px; margin:0 auto; padding:32px; background:#fff; border:1px solid #e5eaf2; border-radius:16px;">
      <tr>
        <td>
          <p style="color:#2563eb; font-weight:700;">Math Solution</p>
          <h1>Password reset</h1>
          <p>Hello <%= fullName %>,</p>
          <p>Use this code to reset your password:</p>
          <p style="text-align:center; font-size:32px; font-weight:700; letter-spacing:10px; color:#1d4ed8;"><%= otp %></p>
          <p>This code expires in <strong><%= expirationMinutes %> minutes</strong>. If you did not request it, you can ignore this email.</p>
        </td>
      </tr>
    </table>
  </body>
</html>
