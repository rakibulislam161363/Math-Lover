model Assignment {
  id             String   @id @default(uuid()) @db.Uuid
  batchId        String   @db.Uuid
  title          String
  instructions   String
  totalMarks     Decimal  @db.Decimal(8, 2)
  dueAt          DateTime?
  attachmentUrl  String?
  isPublished    Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  batch       Batch                   @relation(fields: [batchId], references: [id], onDelete: Cascade)
  submissions AssignmentSubmission[]

  @@index([batchId, isPublished, dueAt])
}

model AssignmentSubmission {
  id          String           @id @default(uuid()) @db.Uuid
  assignmentId String          @db.Uuid
  studentId   String           @db.Uuid
  answerText  String?
  fileUrl     String?
  marks       Decimal?         @db.Decimal(8, 2)
  feedback    String?
  status      SubmissionStatus @default(SUBMITTED)
  submittedAt DateTime         @default(now())
  reviewedAt  DateTime?
  reviewedBy  String?          @db.Uuid
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    User       @relation(fields: [studentId], references: [id], onDelete: Restrict)
  reviewer   User?      @relation("SubmissionReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@unique([assignmentId, studentId])
  @@index([studentId, status])
}
